rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/actions/{actionId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validAction() {
        let data = request.resource.data;
        return data.keys().hasOnly(['title', 'description', 'category', 'priority', 'date', 'time',
          'next', 'uncertainty', 'completed', 'created', 'sourceName', 'sourceBytes', 'sourceMime'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() <= 1500
          && data.category in ['Task', 'Appointment', 'Deadline', 'Bill', 'Delivery', 'Information', 'Saved']
          && data.priority in ['Normal', 'High', 'Low']
          && data.date is string && data.date.size() <= 10
          && data.time is string && data.time.size() <= 5
          && data.next is string && data.next.size() <= 240
          && data.uncertainty is string && data.uncertainty.size() <= 300
          && data.completed is bool && data.created is int
          && (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 512))
          && (('sourceBytes' in data) == ('sourceMime' in data))
          && (!('sourceBytes' in data) || (data.sourceBytes is bytes && data.sourceBytes.size() <= 450000
            && data.sourceMime in ['image/png', 'image/jpeg', 'image/webp']));
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validAction();
    }
  }
}
